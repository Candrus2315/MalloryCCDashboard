# Mallory CC Performance Dashboard — environment template (portability P2, 2026-11-05).
# NAMES + SHAPES ONLY: every value below is a PLACEHOLDER. Copy into your real
# environment and fill in; never commit real values. Full details: DEPLOY.md and
# the compiled inventory /home/team/shared/PORTABILITY_NOTES.md.
# Integration credentials (HighLevel/Acuity/Sheets/Knock) resolve through the
# server's case-insensitive secret resolver — these are their only env names.
# Sheet IDs/tabs and sync intervals live in the DATABASE (Settings page), not env.

# ---------- Serving (managed mode) ----------
# HTTP listen port — honored ONLY when SERVE_MANAGED=1; unmanaged boots always bind 3000 (regression #164). Default: 3000.
PORT=3000
# HTTP listen address — honored ONLY when SERVE_MANAGED=1. Default: 0.0.0.0.
HOST=0.0.0.0
# =1 (exact): managed boot — skips the boot-guard pre-check and the sudo/lsof port-eviction loop; port taken → one log line + exit 1 (the supervisor owns lifecycle). Default: unset (sandbox mode).
SERVE_MANAGED=
# =1: deliberate publish takeover — replace a running server. Not needed on an independent host. Default: unset.
SERVE_SUPERSEDE=

# ---------- Database ----------
# Postgres connection for the business database (any-case variant accepted, e.g. Database_URL). Absent → honest in-memory demo store. Required for Postgres mode.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Shared DB connect budget in ms (clamped 1s–60s) for every pool site. Default: 10000.
DB_CONNECT_TIMEOUT_MS=10000
# Per-await deadline for the /health path in ms (clamped 100–10000) — /health can never hang behind a wedged pool. Default: 2000.
HEALTH_QUERY_DEADLINE_MS=2000
# Explicit grantee for standalone migrations (alternative to `bun run db:migrate --grant "<who>"`; the script REFUSES without a grant).
DB_MIGRATE_GRANT=
# Disposable Postgres for the real-DB test batteries (they skip without it). Test only.
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/TESTDBNAME
# Local disposable DB URLs for one-off scratch scripts. Dev only.
PG_REGRESSION_URL=postgres://USER:PASSWORD@HOST:5432/SCRATCHDB
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/SCRATCHDB

# ---------- Sync + render budgets ----------
# Wall-clock budget per HighLevel sync pass in ms. Default: 600000 (10 min).
HIGHLEVEL_RUN_BUDGET_MS=600000
# SSR page-render deadline in ms (clamped 1s–60s; the page-freeze fix #161). Default: 8000.
PAGE_RENDER_TIMEOUT_MS=8000
# Contacts backfill pacing knobs. Defaults are per-module caps.
CONTACTS_BACKFILL_MAX_PAGES=
CONTACTS_BACKFILL_DELAY_MS=
# Call→contact heal bounds. Defaults are per-module.
CALL_CONTACT_MAX_MINUTES=
CALL_CONTACT_BATCH_SIZE=
CALL_CONTACT_FETCH_MISSING=

# ---------- Access ----------
# Passphrase gate for management APIs. Absent → the gate denies (pages still render).
DASHBOARD_PASSPHRASE=
# Build/runtime mode; mostly decided by the build tooling. Default: unset.
NODE_ENV=

# ---------- Integration credentials (secret resolver, case-insensitive) ----------
# HighLevel API credentials. Absent → sync skips honestly; may also be managed in DB settings.
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
# Acuity API credentials. Absent → availability sync skips.
ACUITY_USER_ID=
ACUITY_API_KEY=
# Google Sheets service account (the seven lead sources). Absent → sheets tick skips. JSON — never logged.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Ops alerts (Knock, Phase 2a) ----------
# Ops-alert delivery via Knock. Absent → log-only alerts.
KNOCK_API_KEY=
KNOCK_SIGNING_KEY=
KNOCK_WORKFLOW_KEY=
ALERT_TO_EMAIL=

# ---------- CTO-sandbox observability paths (an independent host does NOT need these) ----------
# Platform supervisor state read for observability. Missing → "unknown" freshness, never a crash.
SUPERVISOR_STATE_PATH=
# Override the .run/server.lock location. Default: .run/server.lock.
SERVER_LOCK_PATH=
# Heartbeat log location for freshness checks. Default: internal path.
HEARTBEAT_LOG_PATH=
