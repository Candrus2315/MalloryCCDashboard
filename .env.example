# Mallory CC Performance Dashboard — environment variable NAMES ONLY.
# Never put real values in this file or any committed file. Values live in the
# platform Secrets manager (Settings → Secrets) and are injected as runtime env
# vars. The resolver (src/server/env.ts) is case-insensitive on these names.

# Postgres connection string (Neon). Server-only; never exposed to the client.
DATABASE_URL=

# GoHighLevel (Private Integration / API key + location id)
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=

# Acuity Scheduling (user id + API key)
ACUITY_USER_ID=
ACUITY_API_KEY=

# Google Sheets access (service account JSON, single-line stringified)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Dashboard passphrase gate (currently unset = open access, per owner decision)
DASHBOARD_PASSPHRASE=
