node_modules
/dist/
/dist-ssr/
/.vercel/
/.run/
/.output/
/.nitro/
/.cache/
/.tanstack/

# --- Secrets & credentials (values NEVER live in the repo; runtime env only) ---
.env
.env.*
.env.local
# ...but the names-only template IS committed:
!.env.example
*.pem
*.key
*.p12
*service-account*.json
service-account*.json
credentials*.json
secrets*.json

# --- Database exports / generated production data ---
*.sql
*.dump
*.sqlite
*.sqlite3
*.csv

# --- Generated reconciliation / operational exports ---
reconciliation-export*
*recon-export*
harvest-export*
hl-clean.txt
.hl-clean.txt
.recon.ts

# --- Runtime logs & probe artifacts ---
*.log
.verify.txt
scratch-*.ts

# --- Scratch probes stay local (backlog 91c47cdd): the scratch/ dir is
# working debris — never commit it wholesale. Kept read-only artifacts are
# force-added individually (git add -f), e.g. scratch/step5-allreps-probe.ts;
# already-tracked scratch files stay tracked (gitignore never untracks).
scratch/
dist.bak/
nohup.out

# --- OS / generated code ---
.DS_Store
src/routeTree.gen.ts
